# Copy to .env.local. With none of this set, a local `npm run dev` runs in PREVIEW mode: the agents run, nothing can be paid.
#
# To run LIVE locally without copying secrets, point at the Executor's env file and name your wallet as admin:
# COSIGN_LOAD_ENV_FILE=../executor/.env
# COSIGN_ADMIN_ADDRESSES=0xYourMetaMaskAddress
#
# In production (Render etc.) set these in the host's secret settings instead; see docs/DEPLOY.md:
# DATABASE_URL=            (Postgres; without it production refuses to start)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# COSIGN_CIRCLE_WALLETS=   (JSON of wallet ids; scripts/print-deploy-env.ts prints it)
# COSIGN_RELAYER_PRIVATE_KEY=
# COSIGN_ADMIN_ADDRESSES=

# Where the local PGlite database lives when DATABASE_URL is not set (default ./.data/pg).
# COSIGN_DB_DIR=

# Optional free models (any OpenAI-compatible endpoint). Matcher and Sentinel must differ or startup fails.
# MATCHER_LLM=groq:openai/gpt-oss-120b
# SENTINEL_LLM=groq:qwen/qwen3.8-27b
# READER_LLM=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Arc RPC override (default https://rpc.testnet.arc.io).
# ARC_TESTNET_RPC_URL=
