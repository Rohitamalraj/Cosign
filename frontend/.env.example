# Copy to .env.local. Everything is optional in development: with no models the agents run deterministic checks only.

# Required when NODE_ENV=production (`next start`, any deployment). Dev uses a public test mnemonic instead.
# Use a fresh phrase; these derive the five agents' signing keys.
# COSIGN_AGENT_MNEMONIC=

# Optional free models (any OpenAI-compatible endpoint). Matcher and Sentinel must differ or startup fails.
# MATCHER_LLM=groq:llama-3.3-70b-versatile
# SENTINEL_LLM=gemini:gemini-2.0-flash
# READER_LLM=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Pin the clock so the five demo cases are reproducible (otherwise the real date is used).
# COSIGN_DEMO_NOW=2026-10-15T12:00:00Z

# Once the contract is deployed, point the attestations at it (defaults are for local development).
# CHAIN_ID=31337
# POLICY_ADDRESS=0x...

# Where the demo ledger is saved between restarts (default ./.data/state.json).
# COSIGN_STATE_FILE=
